<%= form_for(@rate) do |f| %>
<table class="list">
	<thead>
	  <th style="width:15%"><%= l(:label_date) %></th>
	  <th><%= l(:label_project) %></th>
	  <th style="width:15%"><%= l(:label_rate) %></th>
	  <th style="width:5%"></th>
	</thead>
	<tbody>
	<tr class="odd">
      <td>
        <%# date_field renders <input type="date">, which gives the browser's own
            date picker. A new rate starts out on today's date. %>
        <% date_in_effect = @rate.date_in_effect || User.current.today %>
        <%= f.date_field 'date_in_effect',
                         size: 10,
                         value: date_in_effect.strftime('%Y-%m-%d') %>
      </td>
      <td>
        <%# rate_project_combobox.js turns the drop-down into a type-in field and
            hides it; the select stays the submitted value, so the form keeps
            working without JavaScript. %>
        <span class="rate-project-picker" data-search-label="<%= l(:rate_label_search_projects) %>">
          <%= select_tag('rate[project_id]',
                         rate_project_options(@rate.project),
                         class: 'rate-project-select') %>
        </span>
      </td>
      <td align="right">
        <%= f.text_field "amount", size: 10  %> <%=  currency_name(true) %>
      </td>
      <td align="center">
        <%= f.hidden_field "user_id" %>
        <%= hidden_field_tag "back_url", @back_url %>
        <% if @rate.editable? %>
        <%= submit_tag((@rate.new_record? ? l(:button_add) : l(:button_update)), class: 'button-small')-%>
        <% else %>
        <%= image_tag('locked.png') %>
        <% end %>
      </td>
	</tr>
	</tbody>
</table>
<% end %>

<%# Loaded here rather than through :header_tags so it also arrives when the
    form is rendered from an xhr response (see rates/index.js.erb). %>
<%= javascript_include_tag 'rate_project_combobox', plugin: 'redmine_rate' %>
